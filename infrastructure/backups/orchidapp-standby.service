[Unit]
Description=Verify and accept a new Pi 2 stopped standby restore
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /usr/local/lib/orchidapp-standby/standby_job.py refresh --config /etc/orchidapp-standby/standby.json --email-config /etc/orchidapp-standby/email.json
TimeoutStartSec=2h
TimeoutStopSec=180
KillMode=control-group
