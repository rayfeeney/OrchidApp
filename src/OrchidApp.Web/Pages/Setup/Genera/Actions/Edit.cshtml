@page "{id:int}"
@model OrchidApp.Web.Pages.Setup.Genera.Actions.EditModel
@using OrchidApp.Web.Services

<link rel="stylesheet" href="~/lib/quill/quill.snow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/rich-notes.css" asp-append-version="true" />

<h1 class="page-title fw-bold @(Model.IsInactive ? "text-muted" : "")">
    Edit genus

    @if (Model.IsInactive)
    {
        <span class="badge bg-secondary ms-2">Inactive</span>
    }
</h1>

<h2 class="h5 fw-bold mb-3">
    Update the details of this genus
</h2>

<form method="post" class="mt-3">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

    <input type="hidden" asp-for="Genus.GenusId" />

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <p class="text-muted">
        Changing the genus name will update all species / hybrids and plants that belong to this genus.
        Use this only for spelling corrections or official taxonomic changes.
    </p>

    <div class="mb-3">
        <label asp-for="Genus.Name" class="fw-bold"></label>
        <small class="text-muted d-block fw-normal">
            Spelling correction only.
        </small>
        <input asp-for="Genus.Name" class="form-control" />
        <span asp-validation-for="Genus.Name"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Genus.Notes" class="fw-bold"></label>
        <small id="genus-notes-help" class="text-muted d-block fw-normal">
            Optional notes about this genus. Up to 10,000 characters; bold, italic, underline and lists are supported.
        </small>
        <textarea asp-for="Genus.Notes"
                  class="form-control" rows="6" data-rich-notes data-label="Genus notes"
                  aria-describedby="genus-notes-help"
                  data-editor-html="@RichNotes.EditorHtml(Model.Genus.Notes)"></textarea>
        <span asp-validation-for="Genus.Notes"
              class="text-danger"></span>
    </div>

    <div class="d-grid gap-2 mt-4">

        <button type="submit"
                class="btn btn-primary btn-lg">
            Save genus
        </button>

        <partial name="_BackFullWidth"
                model="@(Model.ReturnUrl ?? Url.Page("/Setup/Genera/Details", new { id = Model.Genus.GenusId }))" />

    </div>
    
</form>
<script src="~/lib/quill/quill.js" asp-append-version="true"></script>
<script src="~/js/rich-notes.js" asp-append-version="true"></script>
