@page
@model OrchidApp.Web.Pages.Setup.Genera.Actions.AddModel
@using OrchidApp.Web.Services

<link rel="stylesheet" href="~/lib/quill/quill.snow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/rich-notes.css" asp-append-version="true" />

<h1 class="page-title fw-bold">Add genus</h1>

<h2 class="h5 fw-bold mb-3">
Create a new botanical group for your plants
</h2>

<p class="text-muted">
A plant group is formally called a <strong>genus</strong>.
For example: Phalaenopsis, Cattleya or Dendrobium.
Each genus only needs to be added once.
</p>

<div class="mt-4">

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    <form method="post">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

        <div class="mb-3">
            <label asp-for="GenusName" class="fw-bold"></label>
            <small class="text-muted d-block fw-normal">
                Enter the botanical genus name.
            </small>
            <input asp-for="GenusName"
                   class="form-control"
                   autocomplete="off" />
            <span asp-validation-for="GenusName"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="GenusNotes" class="fw-bold"></label>
            <small id="genus-notes-help" class="text-muted d-block fw-normal">
                Optional notes about this plant group. Up to 10,000 characters; bold, italic, underline and lists are supported.
            </small>
            <textarea asp-for="GenusNotes"
                      class="form-control"
                      rows="6" data-rich-notes data-label="Genus notes"
                      aria-describedby="genus-notes-help"
                      data-editor-html="@RichNotes.EditorHtml(Model.GenusNotes)"></textarea>
            <span asp-validation-for="GenusNotes"
                  class="text-danger"></span>
        </div>

        <div class="d-grid gap-2 mt-4">

            <button type="submit"
                    class="btn btn-primary btn-lg">
                Add genus
            </button>

            <partial name="_BackFullWidth"
                    model="@(Model.ReturnUrl ?? Url.Page("/Setup/Genera/Index"))" />

        </div>

    </form>

</div>
<script src="~/lib/quill/quill.js" asp-append-version="true"></script>
<script src="~/js/rich-notes.js" asp-append-version="true"></script>
