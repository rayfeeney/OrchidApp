@page "{id:int}"
@model OrchidApp.Web.Pages.Setup.Taxa.Actions.EditModel
@using OrchidApp.Web.Services
<link rel="stylesheet" href="~/lib/quill/quill.snow.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/rich-notes.css" asp-append-version="true" />

<h1 class="page-title fw-bold @(Model.IsInactive ? "text-muted" : "")">
    Edit species / hybrid

    @if (Model.IsInactive)
    {
        <span class="badge bg-secondary ms-2">Inactive</span>
    }
</h1>

<h2 class="h5 fw-bold mb-3">
    @Model.GenusName
</h2>

<p class="text-muted">
    Changing the species or hybrid name will update all plants that use this name.
</p>

<form method="post"
      asp-route-id="@Model.Taxon.TaxonId"
      class="mt-3"
      enctype="multipart/form-data">
    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
      
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger">
    </div>

    @if (Model.Taxon.IsSystemManaged)
    {
        <div class="alert alert-warning">
            This is a system-managed genus record.
            Its name cannot be changed, but notes may be edited.
        </div>
    }
    @if (!Model.Taxon.IsSystemManaged && !string.IsNullOrWhiteSpace(Model.Taxon.SpeciesName))
    {
        <div class="mb-3">
            <label asp-for="Taxon.SpeciesName" class="fw-bold"></label>
            <small class="text-muted d-block fw-normal">
                Use only for spelling corrections or recognised taxonomic updates.
            </small>
            <input asp-for="Taxon.SpeciesName" class="form-control" />
            <span asp-validation-for="Taxon.SpeciesName" class="text-danger"></span>
        </div>
    }

    @if (!Model.Taxon.IsSystemManaged && !string.IsNullOrWhiteSpace(Model.Taxon.HybridName))
    {
        <div class="mb-3">
            <label asp-for="Taxon.HybridName" class="fw-bold"></label>
            <small class="text-muted d-block fw-normal">
                Use only for spelling corrections or recognised taxonomic updates.
            </small>
            <input asp-for="Taxon.HybridName" class="form-control" />
            <span asp-validation-for="Taxon.HybridName" class="text-danger"></span>
        </div>
    }

    <div class="mb-3">
        <label asp-for="Taxon.GrowthNotes" class="fw-bold"></label>
        <small id="growth-notes-help" class="text-muted d-block fw-normal">
            Optional notes about growth characteristics. Up to 10,000 characters; bold, italic, underline and lists are supported.
        </small>
        <textarea asp-for="Taxon.GrowthNotes" class="form-control" rows="6" data-rich-notes
                  data-label="Growth notes" aria-describedby="growth-notes-help"
                  data-editor-html="@RichNotes.EditorHtml(Model.Taxon.GrowthNotes)"></textarea>
        <span asp-validation-for="Taxon.GrowthNotes" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Taxon.TaxonNotes" class="fw-bold"></label>
        <small id="taxon-notes-help" class="text-muted d-block fw-normal">
            Optional notes about this species or hybrid. Up to 10,000 characters; bold, italic, underline and lists are supported.
        </small>
        <textarea asp-for="Taxon.TaxonNotes" class="form-control" rows="6" data-rich-notes
                  data-label="Taxon notes" aria-describedby="taxon-notes-help"
                  data-editor-html="@RichNotes.EditorHtml(Model.Taxon.TaxonNotes)"></textarea>
        <span asp-validation-for="Taxon.TaxonNotes" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="fw-bold">
            Replace image
            <small class="text-muted d-block fw-normal">
                Uploading a new image will replace the current one.
            </small>
        </label>

        <input type="file"
            name="Photo"
            class="form-control"
            accept="image/*" />
    </div>

    <div class="d-grid gap-2 mt-4">

        <button type="submit"
                class="btn btn-primary btn-lg">
            Save species / hybrid
        </button>

        <partial name="_BackFullWidth"
                model="@(Model.ReturnUrl ?? Url.Page("/Setup/Taxa/Details", new { id = Model.Taxon.TaxonId }))" />

    </div>

</form>
<script src="~/lib/quill/quill.js" asp-append-version="true"></script>
<script src="~/js/rich-notes.js" asp-append-version="true"></script>
