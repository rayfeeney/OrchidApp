@page
@model OrchidApp.Web.Pages.IndexModel

<h1 class="page-title fw-bold">Home</h1>

<p class="text-muted">
    Manage your orchid collection and care history.
</p>

@if (Model.EnvironmentSummaryEnabled && Model.EnvironmentSummaries.Any())
{
    <section class="mb-4">
        <div class="row g-3 align-items-start mb-3">
            <div class="col-12 col-md-6">
                <h2 class="h5 fw-bold mb-2">Environment - last 7 days</h2>
                <p class="small text-muted mb-0">
                    Values are shown as <strong class="text-body">Actual</strong>
                    <span class="text-muted">/ Target</span>
                </p>
            </div>
            <div class="col-12 col-md-6">
                <partial name="_GreenhouseNetCosts" model="Model.GreenhouseCosts" />
            </div>
        </div>

        <div class="row g-3">
            @foreach (var summary in Model.EnvironmentSummaries)
            {
                <div class="col-12 col-md-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <h3 class="h6 fw-bold mb-3">@summary.LocationName</h3>

                            <dl class="row mb-0">
                                <dt class="col-7">Day temperature</dt>
                                <dd class="col-5 text-end">
                                    @FormatValue(summary.AverageDayTemperatureCelsius, "°C")
                                    <span class="text-muted">
                                        / @FormatValue(summary.ExpectedDayTemperatureCelsius, "°C")
                                    </span>
                                </dd>

                                <dt class="col-7">Night temperature</dt>
                                <dd class="col-5 text-end">
                                    @FormatValue(summary.AverageNightTemperatureCelsius, "°C")
                                    <span class="text-muted">
                                        / @FormatValue(summary.ExpectedNightTemperatureCelsius, "°C")
                                    </span>
                                </dd>

                                <dt class="col-7">Humidity</dt>
                                <dd class="col-5 text-end">
                                    @FormatValue(summary.AverageRelativeHumidity, "%")
                                    <span class="text-muted">
                                        / @FormatValue(summary.ExpectedRelativeHumidity, "%")
                                    </span>
                                </dd>
                            </dl>

                            @if (Model.GreenhouseCharts.FirstOrDefault(c => c.LocationName == summary.LocationName) is { } chart)
                            {
                                <partial name="_GreenhouseChart" model="chart" />
                            }
                            else if (Model.ChartError is not null)
                            {
                                <p class="small text-muted mt-3" role="status">@Model.ChartError</p>
                            }

                            @if (summary.LastReadingDateTime.HasValue)
                            {
                                <p class="small text-muted mb-0 mt-3">
                                    Last reading: @summary.LastReadingDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@functions {
    private static string FormatValue(decimal? value, string suffix)
    {
        return value.HasValue
            ? $"{value.Value:0.0}{suffix}"
            : "-";
    }
}

<div class="d-grid gap-3 mt-4">

    <a asp-page="/Plants/Index"
       asp-route-returnUrl="@(Request.PathBase + Request.Path + Request.QueryString)"
       class="btn btn-lg btn-outline-primary">
       @* class="btn btn-lg btn-primary"> *@
        Plants
    </a>

    <a asp-page="/Reports/Index"
       asp-route-returnUrl="@(Request.PathBase + Request.Path + Request.QueryString)"
       class="btn btn-lg btn-outline-primary">
        Reports
    </a>

    <a asp-page="/Setup/Index"
       asp-route-returnUrl="@(Request.PathBase + Request.Path + Request.QueryString)"
       class="btn btn-lg btn-outline-primary">
        Setup
    </a>

</div>

@if (Model.EnvironmentSummaryEnabled && Model.GreenhouseCharts.Any())
{
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/js/greenhouse-charts.js" asp-append-version="true"></script>
}

