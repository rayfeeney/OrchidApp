@model (string backUrl, string handler, string saveText, string? confirmationMessage)
@using OrchidApp.Web.Services

@{
    var page = ViewContext.RouteData.Values["page"]?.ToString() ?? "/Index";
    var cancelUrl = AppNavigation.Back(Model.backUrl, Context.Request.PathBase + AppNavigation.Fallback(page, ViewContext.RouteData.Values), Context.Request.PathBase + Context.Request.Path);
    var confirmAttr = string.IsNullOrEmpty(Model.confirmationMessage)
        ? null
        : $"return confirm('{Model.confirmationMessage.Replace("'", "\\'")}');";
}

<div class="d-flex justify-content-between align-items-stretch mt-4">
    <a href="@cancelUrl"
       class="btn btn-outline-secondary">
        Cancel
    </a>

    <button type="submit"
            asp-page-handler="@Model.handler"
            class="btn btn-danger"
            onclick="@confirmAttr">
        @Model.saveText
    </button>
</div>
